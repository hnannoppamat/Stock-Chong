# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LINE Messaging API (Optional): Enables automatic server-side push alerts to LINE ID Hnan145
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_USER_ID=

# LINE Webhook URL (Optional): HTTPS webhook (e.g. Make, Zapier, n8n, Apps Script) to forward alerts to LINE ID Hnan145
LINE_WEBHOOK_URL=

# Photo Upload CDN (Optional): ImgBB API key for permanent external CDN image URLs (defaults to built-in server photo API)
IMGBB_API_KEY=
